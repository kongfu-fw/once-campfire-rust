# Campfire 环境变量配置
# =====================

# Rails 密钥 (自动生成)
SECRET_KEY_BASE=

# SSL 配置
# 如果你有域名并且需要自动 SSL，请取消注释并填写域名：
# SSL_DOMAIN=chat.example.com
# 如果通过反向代理（如 Nginx/Caddy）处理 SSL，保留 DISABLE_SSL=true
DISABLE_SSL=true

# Web Push 通知 (VAPID 密钥对，自动生成)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# Sentry 错误监控 (可选)
# SENTRY_DSN=
